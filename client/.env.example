# Where the Go API listens. The browser never talks to it directly; the Next.js
# server proxies /api/proxy/* to it and keeps tokens in HttpOnly cookies.
BACKEND_URL=http://localhost:8080

# Set to "false" to allow the session cookies over plain http outside production.
# Production builds set Secure cookies unless this is "false".
# COOKIE_SECURE=false

# Storage providers reached over plain http (for example the local MinIO) must be
# allowed explicitly in the Content-Security-Policy. https providers need nothing.
# Read at build time: set it when running `npm run build`.
# CSP_STORAGE_ORIGINS=http://127.0.0.1:9000
