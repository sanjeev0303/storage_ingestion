# Copy to terraform.tfvars (git-ignored) and fill in. No secrets belong in
# this file: secrets live in Secrets Manager (scripts/init-secrets.sh).

aws_account_id     = "123456789012"
region             = "ap-southeast-1"
availability_zones = ["ap-southeast-1a", "ap-southeast-1b", "ap-southeast-1c"]

domain_name       = "example.com"
route53_zone_id   = "Z0123456789ABCDEFGHIJ"
console_subdomain = "console"
api_subdomain     = "api"

admin_email  = "platform-admin@example.com"
alarm_emails = ["oncall@example.com"]

# Set by scripts/deploy.sh on every run (-var image_tag=<git sha>); this
# value is only used if you run terraform by hand.
image_tag = "REPLACE_WITH_DEPLOYED_GIT_SHA"

db_instance_class        = "db.r6g.large"
db_allocated_storage_gb  = 100
db_multi_az              = true
db_backup_retention_days = 14

byos_enabled      = true
self_registration = false

# Tuning knobs from server/.env.example, for example:
# server_environment_overrides = {
#   PROCESSING_SCAN_PARALLELISM = "8"
#   ARCHIVE_INSPECTION_ENABLED  = "true"
# }

# Per-worker sizing, for example:
# worker_overrides = {
#   "processing-worker" = { cpu = 4096, memory = 16384, desired_count = 4 }
# }
