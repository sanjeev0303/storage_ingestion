# syntax=docker/dockerfile:1
# The Next.js console (client/). It talks only to the API, through its own
# server, and keeps tokens in HttpOnly cookies.
#
# Build from client/:
#   docker build -f ../server/infrastructure/docker/Dockerfile.console -t console:<tag> .
#
# CSP_STORAGE_ORIGINS is read at build time; it is only needed for storage
# reached over plain http, which production does not use.

FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=build --chown=node:node /app ./
USER node
EXPOSE 3100

# next directly, not npm, so ECS's stop signal reaches the server.
CMD ["node_modules/.bin/next", "start", "-p", "3100"]
