APP_ENV=development
HTTP_PORT=8080

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# S3-compatible storage
S3_REGION=ap-southeast-1
S3_BUCKET=your-private-quarantine-bucket
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false

# Upload policy
UPLOAD_MAX_SIZE_BYTES=5368709120
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_SECONDS=1800

# Reconciliation worker (see docs/multipart-reliability.md)
RECONCILIATION_SESSION_SCAN=database
RECONCILIATION_UNRECORDED_ACTION=report
RECONCILIATION_ORPHAN_MIN_AGE=24h
RECONCILIATION_STUCK_AFTER=1h
RECONCILIATION_SESSION_LOOKBACK=168h
RECONCILIATION_DRY_RUN=false
# The provider label recorded on reconciliation tasks (default s3).
# STORAGE_PROVIDER=s3
METRICS_ADDR=

# Processing worker (see docs/content-security.md)
SCANNER=clamav
CLAMAV_ADDRESS=127.0.0.1:3310
CLAMAV_TIMEOUT=2m
SCAN_UNAVAILABLE_POLICY=hold
PROCESSING_LEASE_DURATION=15m
PROCESSING_MAX_ATTEMPTS=8
PROCESSING_MAX_FILE_BYTES=5368709120
PROCESSING_ALLOWED_CONTENT_TYPES=
PROCESSING_DENIED_CONTENT_TYPES=
PROCESSING_UNKNOWN_TYPE_ACTION=allow
QUARANTINE_RETENTION=720h
ARCHIVE_INSPECTION_ENABLED=false
ARCHIVE_MAX_BYTES=536870912
ARCHIVE_MAX_ENTRIES=10000
ARCHIVE_MAX_UNCOMPRESSED_BYTES=2147483648
ARCHIVE_MAX_RATIO=100
PROMOTION_BUCKET=
PROMOTION_PREFIX=assets

# Delivery API (see docs/delivery.md). PROMOTION_BUCKET/PREFIX above are
# also where delivery reads from.
DELIVERY_PROXY_ENABLED=true
DELIVERY_URL_MODE=storage
DELIVERY_URL_TTL=5m
DELIVERY_URL_MAX_TTL=15m
DELIVERY_STALL_TIMEOUT=30s
DELIVERY_MAX_STREAMS=64
DELIVERY_CDN_ENABLED=false
# Required when DELIVERY_CDN_ENABLED=true (CloudFront signed URLs):
# DELIVERY_CDN_BASE_URL=
# DELIVERY_CDN_KEY_PAIR_ID=
# DELIVERY_CDN_PRIVATE_KEY_FILE=

# Retention and lifecycle (see docs/lifecycle.md). Destructive steps that
# are not explicit requests default to report.
LIFECYCLE_EXPIRATION=report
LIFECYCLE_ORPHAN_ACTION=report
LIFECYCLE_ORPHAN_UNRECORDED=report
LIFECYCLE_POLL_INTERVAL=1m
LIFECYCLE_BATCH_SIZE=100
LIFECYCLE_CONCURRENCY=2
LIFECYCLE_LEASE_DURATION=5m
LIFECYCLE_MAX_ATTEMPTS=8
LIFECYCLE_BACKOFF_BASE=30s
LIFECYCLE_BACKOFF_MAX=30m
LIFECYCLE_RECHECK_INTERVAL=1h
LIFECYCLE_MAX_DELETIONS=100
LIFECYCLE_ORPHAN_MIN_AGE=24h
LIFECYCLE_ORPHAN_SAFETY_INTERVAL=24h
LIFECYCLE_ORPHAN_OBSERVATIONS=2
LIFECYCLE_FAILED_UPLOAD_RETENTION=720h
LIFECYCLE_SCAN_PAGE_SIZE=500
LIFECYCLE_SCAN_PAGES=10
LIFECYCLE_MAX_SCAN_ERRORS=5
LIFECYCLE_CHECK_BATCH=200
RETENTION_DEFAULT_MIN_RETENTION=0s
RETENTION_DEFAULT_MAX_AGE=0s
RETENTION_DEFAULT_DELETION_GRACE=168h
RETENTION_MIN_RETENTION_FLOOR=0s
RETENTION_DELETION_GRACE_FLOOR=1h

# Metadata compaction: a dry run unless enabled.
COMPACTION_ENABLED=false
COMPACTION_POLL_INTERVAL=1h
COMPACTION_BATCH_SIZE=1000
COMPACTION_MAX_BATCHES=100
COMPACTION_BATCH_PAUSE=0s
COMPACTION_AUDIT_RETENTION=8760h
COMPACTION_OPERATIONAL_RETENTION=720h
COMPACTION_IDEMPOTENCY_TTL=168h

# Event pipeline (see docs/events.md). Events are always written to the
# outbox; EVENT_QUEUE=sqs publishes and consumes them. Locally, ElasticMQ
# from docker-compose.yml stands in for SQS and accepts any credentials.
EVENT_QUEUE=
SQS_REGION=us-east-1
SQS_ENDPOINT=http://127.0.0.1:9324
SQS_ACCESS_KEY_ID=local
SQS_SECRET_ACCESS_KEY=local
SQS_QUEUE_PREFIX=storage-
SQS_CREATE_QUEUES=true
SQS_MAX_RECEIVE_COUNT=20
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
OUTBOX_CONCURRENCY=4
OUTBOX_LEASE=1m
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE=2s
OUTBOX_BACKOFF_MAX=5m
EVENT_BATCH_SIZE=10
EVENT_CONCURRENCY=4
EVENT_VISIBILITY=1m
EVENT_WAIT=10s
EVENT_HANDLER_TIMEOUT=15m
EVENT_MAX_ATTEMPTS=8
EVENT_BACKOFF_BASE=5s
EVENT_BACKOFF_MAX=15m
EVENT_RECONCILE_INTERVAL=1m
EVENT_STUCK_AFTER=15m
EVENT_RECONCILE_WINDOW=72h
EVENT_MAX_REPUBLISH=3
EVENT_RECONCILE_BATCH=100

# Bulk ingestion (see docs/ingestion.md). The API and the upload worker
# read these; both must agree.
INGESTION_SMALL_FILE_THRESHOLD=16777216
INGESTION_MAX_OBJECT_BYTES=53687091200
INGESTION_MAX_MANIFEST_BYTES=2147483648
INGESTION_MAX_INLINE_MANIFEST_BYTES=16777216
INGESTION_MAX_ENTRIES_PER_JOB=5000000
INGESTION_MAX_LINE_BYTES=16384
INGESTION_MAX_PATH_BYTES=1024
INGESTION_MAX_SEGMENT_BYTES=255
INGESTION_MAX_PATH_DEPTH=64
INGESTION_MAX_METADATA_BYTES=2048
INGESTION_MAX_METADATA_KEYS=32
INGESTION_GLOBAL_UPLOAD_SLOTS=256
INGESTION_TENANT_UPLOAD_SLOTS=64
INGESTION_JOB_UPLOAD_SLOTS=32
INGESTION_TENANT_MULTIPART_SESSIONS=16
INGESTION_MAX_PART_URLS=100
INGESTION_MAX_CLAIM=100
INGESTION_TENANT_PROCESSING_BACKLOG=2000
INGESTION_MAX_ATTEMPTS=5
INGESTION_MAX_MANUAL_RETRIES=3
INGESTION_INSERT_BATCH=1000
INGESTION_WORKER_BATCH=500
INGESTION_STORAGE_CONCURRENCY=32
INGESTION_PARSE_CONCURRENCY=2
INGESTION_SLOT_LEASE=15m
INGESTION_UPLOAD_URL_TTL=15m
INGESTION_RETRY_BACKOFF_BASE=30s
INGESTION_RETRY_BACKOFF_MAX=30m
INGESTION_POLL_INTERVAL=5s
INGESTION_MANIFEST_LEASE=2m
INGESTION_PARSE_BUDGET=5m
INGESTION_OUTCOME_SYNC_AFTER=2m
INGESTION_RECONCILE_INTERVAL=10m
INGESTION_STORAGE_TIMEOUT=30s

# Authentication, tenancy, quotas and audit (see docs/security.md). Invalid
# values stop the API and the workers at startup. There is no development
# identity: create the first administrator with
#   go run ./cmd/identity-admin bootstrap -email you@example.com
AUTH_MODE=token
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_PASSWORD_MIN_LENGTH=12
# Argon2id cost; at least 19456 KiB and 2 passes.
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME=3
AUTH_ARGON2_THREADS=2
AUTH_INVITATION_TTL=168h
AUTH_ACTIVATION_TTL=72h
AUTH_RESET_TTL=1h
# Failed sign-ins per email and address, and per address, in the window.
AUTH_LOGIN_ATTEMPTS=5
AUTH_LOGIN_IP_ATTEMPTS=50
AUTH_LOGIN_WINDOW=15m
# Only behind a proxy that sets X-Forwarded-For itself.
AUTH_TRUST_PROXY_HEADERS=false
# Lets anyone create an account and an organization at POST /auth/register.
# Off by default: there is no email delivery, so addresses are not verified.
AUTH_SELF_REGISTRATION=false
AUDIT_RETENTION=17520h

# Rate limits, requests/window. In-memory, per API process.
RATE_LIMIT_REFRESH=30/1m
RATE_LIMIT_CREDENTIALS=10/15m
# Self-registration attempts per source address.
RATE_LIMIT_REGISTER=5/1h
RATE_LIMIT_UPLOAD_INIT=300/1m
RATE_LIMIT_UPLOAD_FINISH=600/1m
RATE_LIMIT_MANIFEST=60/1m
RATE_LIMIT_JOB_CREATE=60/1m
RATE_LIMIT_DOWNLOAD_URL=600/1m
RATE_LIMIT_LISTING=600/1m
RATE_LIMIT_ADMIN=120/1m
RATE_LIMIT_MEMBERSHIP=120/1m

# Default per-organization quotas; platform administrators override them
# per organization (PUT /api/v1/admin/organizations/{id}/quota). These
# replace INGESTION_TENANT_STORAGE_QUOTA, INGESTION_MAX_ACTIVE_JOBS and
# INGESTION_MAX_PENDING_ENTRIES, which now stop startup if set.
QUOTA_MAX_STORAGE_BYTES=1099511627776
QUOTA_MAX_ASSETS=10000000
QUOTA_MAX_OBJECT_BYTES=53687091200
QUOTA_MAX_ACTIVE_UPLOADS=200
QUOTA_MAX_ACTIVE_MULTIPART=50
QUOTA_MAX_ACTIVE_JOBS=10
QUOTA_MAX_PENDING_PROCESSING=5000
QUOTA_MAX_PENDING_ENTRIES=10000000
QUOTA_MAX_MANIFEST_ENTRIES=5000000
QUOTA_MAX_MANIFEST_BYTES=2147483648
QUOTA_MAX_REQUESTS_PER_MINUTE=6000

# Object catalog listings (see docs/catalog.md). Invalid values stop the
# API and the cleanup worker at startup.
CATALOG_DEFAULT_PAGE_SIZE=100
CATALOG_MAX_PAGE_SIZE=1000
CATALOG_QUERY_TIMEOUT=5s
CATALOG_SLOW_QUERY=500ms
CATALOG_MAX_METADATA_FILTERS=4

# Managed datasets (see docs/datasets.md): pages, bulk changes, snapshots,
# manifest imports and validation jobs. Invalid values stop the API and the
# dataset worker at startup. Tenant quotas can lower the manifest limits.
DATASET_DEFAULT_PAGE_SIZE=100
DATASET_MAX_PAGE_SIZE=1000
DATASET_MAX_BULK_MEMBERS=1000
DATASET_MAX_SNAPSHOT_MEMBERS=5000000
DATASET_MAX_INLINE_MANIFEST_BYTES=8388608
DATASET_MAX_MANIFEST_BYTES=1073741824
DATASET_MANIFEST_MAX_LINE_BYTES=65536
DATASET_MAX_MANIFEST_ENTRIES=10000000
DATASET_IMPORT_BATCH=500
DATASET_MAX_IMPORT_ERRORS=10000
DATASET_IMPORT_BUDGET=1m
DATASET_VALIDATION_BATCH=500
DATASET_CONTENT_CONCURRENCY=4
DATASET_OBJECT_TIMEOUT=1m
DATASET_VALIDATION_BUDGET=1m
DATASET_MAX_JOB_DURATION=6h
DATASET_DEFAULT_SAMPLE_SIZE=100
DATASET_MAX_SAMPLE_SIZE=10000
DATASET_MAX_FINDINGS_PER_RULE=10000
DATASET_DISTRIBUTION_TOP=50
DATASET_MAX_ACTIVE_IMPORTS=10
DATASET_MAX_ACTIVE_VALIDATIONS=10
DATASET_RUNNING_PER_TENANT=2
DATASET_LEASE=3m
DATASET_MAX_ATTEMPTS=5
DATASET_BACKOFF_BASE=5s
DATASET_BACKOFF_MAX=5m
DATASET_LINEAGE_MAX_DEPTH=10
DATASET_LINEAGE_MAX_EDGES=10000
DATASET_LINEAGE_QUERY_TIMEOUT=5s
DATASET_POLL_INTERVAL=5s
DATASET_WORKER_SLOTS=2
# The dataset worker's /health and /debug/vars listener; empty disables it.
DATASET_METRICS_ADDR=

# Storage connections (see docs/storage-connections.md). Off, every
# organization uses the platform-managed buckets above and nothing below is
# needed. On, organizations may connect their own AWS S3, Cloudflare R2,
# Google Cloud Storage, Azure Blob or S3-compatible storage, and every
# process (API and workers) needs the same credential keys.
BYOS_ENABLED=false
# Dedicated 32-byte keys that seal stored credentials (AES-256-GCM), as
# version:base64. Generate one with: openssl rand -base64 32
# Never reuse a database password, JWT secret or provider key here. Keep
# old versions listed after a rotation until credentials are re-sealed.
STORAGE_CREDENTIAL_KEYS=1:REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
STORAGE_CREDENTIAL_KEY_VERSION=1
# Development only: lets connections point at plain-http, loopback and
# private addresses (MinIO, fake-gcs-server, Azurite). Refused outside
# APP_ENV=development.
STORAGE_ALLOW_PRIVATE_ENDPOINTS=false
STORAGE_CLIENT_CACHE_SIZE=256
STORAGE_CLIENT_CACHE_TTL=15m
STORAGE_CONNECTION_CACHE_TTL=10s
STORAGE_OPERATION_TIMEOUT=2m
STORAGE_TEST_TIMEOUT=20s
STORAGE_MAX_CONCURRENT_PER_CONNECTION=32
# The buffer of a streaming copy between connections (5-256 MiB).
STORAGE_TRANSFER_PART_BYTES=16777216
RATE_LIMIT_STORAGE_TEST=10/1m
RATE_LIMIT_STORAGE_ADMIN=60/1m
